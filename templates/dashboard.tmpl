{{define "dashboard"}}
{{template "header" .}}
<section class="page-title">
  <p class="eyebrow">Espace personnel</p>
  <h1>Dashboard</h1>
  <p>Retrouve les sujets que tu as publiés ou likés.</p>
</section>

<div class="tabs" role="tablist" aria-label="Filtres dashboard">
  <a class="tab {{if eq .DashboardFilter "posted"}}is-selected{{end}}" href="/dashboard?filter=posted">Mes sujets</a>
  <a class="tab {{if eq .DashboardFilter "liked"}}is-selected{{end}}" href="/dashboard?filter=liked">Sujets likés</a>
</div>

<section class="stack wide-stack">
  {{range .Threads}}
    {{template "thread_card" .}}
  {{else}}
    <div class="card empty-card">
      {{if eq .DashboardFilter "liked"}}
        <p>Tu n'as encore liké aucun sujet.</p>
      {{else}}
        <p>Tu n'as pas encore publié de sujet.</p>
        <a class="button" href="/thread/create">Créer ton premier sujet</a>
      {{end}}
    </div>
  {{end}}
</section>
{{template "footer" .}}
{{end}}
