{{define "category"}}
{{template "header" .}}
<section class="page-title">
  <a class="back-link" href="/">← Retour à l'accueil</a>
  <p class="eyebrow">Catégorie</p>
  <h1>{{.Category.Name}}</h1>
  <p>{{.Category.Description}}</p>
</section>

<section class="stack wide-stack">
  {{range .Threads}}
    {{template "thread_card" .}}
  {{else}}
    <div class="card empty-card">
      <p>Aucun sujet dans cette catégorie.</p>
      {{if $.User}}<a class="button" href="/thread/create">Créer un sujet</a>{{end}}
    </div>
  {{end}}
</section>
{{template "footer" .}}
{{end}}
