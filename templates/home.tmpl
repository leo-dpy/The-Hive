{{define "home"}}
{{template "header" .}}
<section class="hero">
  <div>
    <p class="eyebrow">Forum communautaire</p>
    <h1>Bienvenue dans The Hive</h1>
    <p>Lis les sujets publiés, explore les catégories, puis connecte-toi pour publier, commenter, liker ou disliker.</p>
    {{if .User}}
      <a class="button" href="/thread/create">Créer un nouveau sujet</a>
    {{else}}
      <div class="hero-actions">
        <a class="button" href="/register">Rejoindre la ruche</a>
        <a class="button button-secondary" href="/login">Se connecter</a>
      </div>
    {{end}}
  </div>
</section>

<section class="grid two-columns">
  <div>
    <div class="section-heading">
      <h2>Catégories</h2>
      <span class="muted">Filtrage public</span>
    </div>
    <div class="category-grid">
      {{range .Categories}}
        <a class="card category-card" href="/category?id={{.ID}}">
          <strong>{{.Name}}</strong>
          <span>{{.Description}}</span>
        </a>
      {{else}}
        <p class="empty">Aucune catégorie disponible.</p>
      {{end}}
    </div>
  </div>

  <div>
    <div class="section-heading">
      <h2>Sujets récents</h2>
      <span class="muted">20 derniers sujets</span>
    </div>
    <div class="stack">
      {{range .Threads}}
        {{template "thread_card" .}}
      {{else}}
        <p class="empty">Aucun sujet pour le moment. Connecte-toi pour lancer la première discussion.</p>
      {{end}}
    </div>
  </div>
</section>
{{template "footer" .}}
{{end}}
