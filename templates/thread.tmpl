{{define "thread"}}
{{template "header" .}}
<article class="card thread-detail">
  <a class="back-link" href="/category?id={{.Thread.CategoryID}}">← {{.Thread.CategoryName}}</a>
  <div class="thread-card-header">
    <span class="pill">{{.Thread.CategoryName}}</span>
    <span class="muted">par {{.Thread.Author}} · {{.Thread.CreatedAt}}</span>
  </div>
  <h1>{{.Thread.Title}}</h1>
  <p class="thread-body">{{.Thread.Content}}</p>
  <div class="reaction-row">
    {{if .User}}
      <form action="/react" method="post">
        <input type="hidden" name="target_type" value="thread">
        <input type="hidden" name="target_id" value="{{.Thread.ID}}">
        <input type="hidden" name="value" value="1">
        <input type="hidden" name="redirect" value="{{.CurrentPath}}">
        <button class="reaction-button {{reactionClass .Thread.UserReaction 1}}" type="submit">👍 {{.Thread.Likes}}</button>
      </form>
      <form action="/react" method="post">
        <input type="hidden" name="target_type" value="thread">
        <input type="hidden" name="target_id" value="{{.Thread.ID}}">
        <input type="hidden" name="value" value="-1">
        <input type="hidden" name="redirect" value="{{.CurrentPath}}">
        <button class="reaction-button {{reactionClass .Thread.UserReaction -1}}" type="submit">👎 {{.Thread.Dislikes}}</button>
      </form>
    {{else}}
      <span>👍 {{.Thread.Likes}}</span>
      <span>👎 {{.Thread.Dislikes}}</span>
      <a href="/login">Connecte-toi pour réagir</a>
    {{end}}
  </div>
</article>

<section class="comments">
  <div class="section-heading">
    <h2>Commentaires</h2>
    <span class="muted">{{len .Comments}} réponse{{if ne (len .Comments) 1}}s{{end}}</span>
  </div>

  {{if .User}}
    <form class="card form-card" action="/comment/add" method="post">
      <input type="hidden" name="thread_id" value="{{.Thread.ID}}">
      <label for="content">Ajouter un commentaire</label>
      <textarea id="content" name="content" rows="4" minlength="2" maxlength="3000" required></textarea>
      <div class="form-footer">
        <span class="counter" data-for="content">0 / 3000</span>
        <button class="button" type="submit">Publier</button>
      </div>
    </form>
  {{else}}
    <div class="card empty-card">
      <p>Connecte-toi pour commenter ce sujet.</p>
      <a class="button" href="/login">Connexion</a>
    </div>
  {{end}}

  <div class="stack">
    {{range .Comments}}
      <article class="card comment-card">
        <div class="thread-card-header">
          <strong>{{.Author}}</strong>
          <span class="muted">{{.CreatedAt}}</span>
        </div>
        <p>{{.Content}}</p>
        <div class="reaction-row compact">
          {{if $.User}}
            <form action="/react" method="post">
              <input type="hidden" name="target_type" value="comment">
              <input type="hidden" name="target_id" value="{{.ID}}">
              <input type="hidden" name="value" value="1">
              <input type="hidden" name="redirect" value="{{$.CurrentPath}}">
              <button class="reaction-button {{reactionClass .UserReaction 1}}" type="submit">👍 {{.Likes}}</button>
            </form>
            <form action="/react" method="post">
              <input type="hidden" name="target_type" value="comment">
              <input type="hidden" name="target_id" value="{{.ID}}">
              <input type="hidden" name="value" value="-1">
              <input type="hidden" name="redirect" value="{{$.CurrentPath}}">
              <button class="reaction-button {{reactionClass .UserReaction -1}}" type="submit">👎 {{.Dislikes}}</button>
            </form>
          {{else}}
            <span>👍 {{.Likes}}</span>
            <span>👎 {{.Dislikes}}</span>
          {{end}}
        </div>
      </article>
    {{else}}
      <p class="empty">Aucun commentaire pour le moment.</p>
    {{end}}
  </div>
</section>
{{template "footer" .}}
{{end}}
