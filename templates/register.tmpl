{{define "register"}}
{{template "header" .}}
<section class="auth-layout">
  <div class="auth-copy">
    <p class="eyebrow">Inscription</p>
    <h1>Rejoins The Hive</h1>
    <p>Les mots de passe sont hashés avec bcrypt. Une session par cookie UUID expirant est créée après l'inscription.</p>
  </div>
  <form class="card form-card" action="/auth/register" method="post">
    <label for="username">Pseudo</label>
    <input id="username" type="text" name="username" minlength="3" maxlength="32" required autocomplete="username">

    <label for="email">Email</label>
    <input id="email" type="email" name="email" required autocomplete="email">

    <label for="password">Mot de passe</label>
    <input id="password" type="password" name="password" minlength="8" required autocomplete="new-password">

    <button class="button full-width" type="submit">Créer mon compte</button>
    <p class="muted centered">Déjà inscrit ? <a href="/login">Se connecter</a></p>
  </form>
</section>
{{template "footer" .}}
{{end}}
