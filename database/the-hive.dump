INSERT INTO `comments` VALUES (3,2,2,'abc','2026-05-04 17:01:38'),(4,1,2,'Super initiative ! Hâte de voir cette communauté grandir 🙌','2026-05-04 17:30:28'),(5,1,3,'Merci pour la plateforme ! L\'interface est vraiment clean.','2026-05-04 17:30:28'),(6,1,5,'Hello tout le monde ! Contente d\'être ici 🐝','2026-05-04 17:30:28'),(7,1,12,'Salut depuis les étoiles ! ✨','2026-05-04 17:30:28'),(8,1,20,'Enfin un forum sympa, merci !','2026-05-04 17:30:28'),(9,2,6,'Notion pour moi aussi, avec des templates custom. Game changer !','2026-05-04 17:30:28'),(10,2,9,'Un bon planning papier et c\'est réglé. Old school mais efficace.','2026-05-04 17:30:28'),(11,2,13,'J\'utilise Todoist + Google Calendar. La combo parfaite.','2026-05-04 17:30:28'),(12,3,9,'Thé vert le matin, café l\'après-midi. Le meilleur des deux mondes ☕🍵','2026-05-04 17:30:28'),(13,3,16,'Thé matcha pour moi ! Énergie sans le crash du café.','2026-05-04 17:30:28'),(14,3,11,'Café noir, sans sucre, sans discussion ☕','2026-05-04 17:30:28'),(15,3,25,'Eau citronnée. Oui je suis cette personne 😂','2026-05-04 17:30:28'),(16,5,3,'Atomic Habits de James Clear. Un game changer pour mes habitudes.','2026-05-04 17:30:28'),(17,5,18,'L\'Étranger de Camus. Court mais tellement puissant.','2026-05-04 17:30:28'),(18,5,15,'1984 de Orwell. Plus pertinent que jamais.','2026-05-04 17:30:28'),(19,7,3,'VSCode + extensions Go = combo parfaite.','2026-05-04 17:30:28'),(20,7,6,'Neovim + tmux ici. Pas besoin de souris 😎','2026-05-04 17:30:28'),(21,7,23,'JetBrains GoLand. Cher mais tellement productif.','2026-05-04 17:30:28'),(22,7,13,'Terminal + Vim depuis un café à Bali. La belle vie.','2026-05-04 17:30:28'),(23,8,1,'Podman est top pour la sécurité, pas besoin de daemon root.','2026-05-04 17:30:28'),(24,8,3,'Je reste sur Docker pour la compatibilité.','2026-05-04 17:30:28'),(25,8,17,'Du point de vue sécu, Podman gagne haut la main.','2026-05-04 17:30:28'),(26,9,6,'Go est excellent pour le backend. Simple et rapide.','2026-05-04 17:30:29'),(27,9,1,'Je recommande le tour officiel : tour.golang.org','2026-05-04 17:30:29'),(28,9,7,'Go + MySQL c\'est une super combo. Fonce !','2026-05-04 17:30:29'),(29,9,23,'La stdlib de Go est incroyable. Pas besoin de framework.','2026-05-04 17:30:29'),(30,11,6,'Commence par TryHackMe, c\'est le meilleur pour débuter.','2026-05-04 17:30:29'),(31,11,23,'La certif CEH est un bon début, mais rien ne vaut la pratique.','2026-05-04 17:30:29'),(32,11,1,'HackTheBox pour les challenges. Addictif !','2026-05-04 17:30:29'),(33,13,1,'Flutter pour la perf, React Native pour l\'écosystème JS.','2026-05-04 17:30:29'),(34,13,22,'Flutter ! Le hot reload change la vie.','2026-05-04 17:30:29'),(35,16,1,'Elden Ring aussi ! Le DLC est incroyable.','2026-05-04 17:30:29'),(36,16,4,'Zelda Tears of the Kingdom pour moi.','2026-05-04 17:30:29'),(37,16,9,'Baldur\'s Gate 3, impossible de décrocher.','2026-05-04 17:30:29'),(38,16,24,'Je suis sur mon propre jeu... ça compte ? 😅','2026-05-04 17:30:29'),(39,17,8,'Silksong est un chef-d\'œuvre, l\'attente valait le coup !','2026-05-04 17:30:29'),(40,17,14,'Celeste reste mon indé préféré de tous les temps.','2026-05-04 17:30:29'),(41,19,2,'Godot est open source et progresse énormément. Je recommande.','2026-05-04 17:30:29'),(42,19,24,'J\'utilise Godot et c\'est parfait pour un solo dev. Fonce !','2026-05-04 17:30:29'),(43,20,8,'Baldur\'s Gate 3 a détrôné tous les RPG pour moi.','2026-05-04 17:30:29'),(44,20,14,'Final Fantasy VI mérite d\'être mentionné.','2026-05-04 17:30:29'),(45,20,24,'Disco Elysium. Pas de combat, juste du pur RPG narratif.','2026-05-04 17:30:29'),(46,24,10,'J\'écoute en boucle depuis la sortie 🎶','2026-05-04 17:30:29'),(47,24,2,'Pas encore écouté mais tu me donnes envie !','2026-05-04 17:30:29'),(48,24,22,'Pomme est incroyable live aussi, allez la voir en concert !','2026-05-04 17:30:29'),(56,31,9,'Super ! Tu peux partager le programme complet ?','2026-05-04 17:30:30'),(57,31,16,'Ajoute du yoga pour la récupération, ça change tout.','2026-05-04 17:30:30'),(58,33,2,'Severance mérite la première place !','2026-05-04 17:30:30'),(59,33,5,'J\'ajouterais Succession et Mr. Robot.','2026-05-04 17:30:30'),(60,33,14,'Et Arcane ? Meilleure adaptation de jeu vidéo.','2026-05-04 17:30:30'),(61,33,20,'Dark est sous-coté. La meilleure série de SF.','2026-05-04 17:30:30'),(62,34,1,'Villeneuve est un génie. Chaque plan est un tableau.','2026-05-04 17:30:30'),(63,34,15,'Meilleur film de SF de la décennie, sans hésiter.','2026-05-04 17:30:30'),(64,35,14,'One Piece continue de me surprendre même après 1000 épisodes.','2026-05-04 17:30:30'),(65,35,24,'Frieren est la pépite de cette saison !','2026-05-04 17:30:30'),(66,36,8,'Princesse Mononoké pour moi. Thématiques profondes.','2026-05-04 17:30:30'),(67,36,5,'Mon Voisin Totoro. La nostalgie pure.','2026-05-04 17:30:30'),(68,36,20,'Le Château Ambulant. L\'animation est juste parfaite.','2026-05-04 17:30:30'),(69,38,1,'Essaie les startups, elles sont plus flexibles pour les stages.','2026-05-04 17:30:30'),(70,38,4,'LinkedIn est ton ami ! Contacte directement les recruteurs.','2026-05-04 17:30:30'),(71,38,23,'Fais des projets Kaggle pour ton portfolio.','2026-05-04 17:30:30'),(72,40,6,'LeetCode c\'est bien mais les projets perso impressionnent plus.','2026-05-04 17:30:30'),(73,40,23,'Prépare des questions à poser. Ça montre ton intérêt.','2026-05-04 17:30:31'),(74,40,17,'Pour la cybersé, les CTF valent mieux que LeetCode.','2026-05-04 17:30:31'),(75,42,1,'Merci du retour ! Tu factures à l\'heure ou au projet ?','2026-05-04 17:30:31'),(76,42,23,'Le plus dur c\'est la régularité des revenus. Des conseils ?','2026-05-04 17:30:31'),(77,43,14,'Les bento grids sont partout en ce moment. J\'adore !','2026-05-04 17:30:31'),(78,43,19,'L\'accessibilité devrait être LA tendance prioritaire.','2026-05-04 17:30:31'),(79,47,16,'Tu peux partager la recette complète ? 🍜','2026-05-04 17:30:31'),(80,47,25,'Les ramen maison c\'est le niveau au-dessus. Bravo !','2026-05-04 17:30:31'),(81,47,7,'Le secret c\'est le bouillon. Combien de temps de cuisson ?','2026-05-04 17:30:31'),(82,49,21,'Banane + beurre de cacahuète + protéine = combo parfaite.','2026-05-04 17:30:31'),(83,49,9,'Je rajoute toujours des épinards. On sent pas le goût !','2026-05-04 17:30:31'),(84,51,11,'Quel budget mensuel à Bali ? Ça me tente grave.','2026-05-04 17:30:31'),(85,51,22,'Le wifi est fiable pour le dev ? C\'est ma plus grande peur.','2026-05-04 17:30:31'),(86,51,19,'Tu recommandes quel quartier pour le coworking ?','2026-05-04 17:30:31'),(87,53,12,'La plongée de nuit c\'est encore un autre niveau !','2026-05-04 17:30:31'),(88,53,16,'Koh Tao est magique. J\'y ai passé mon PADI.','2026-05-04 17:30:31'),(89,55,18,'Fascinant ! La méthode des transits est incroyable.','2026-05-04 17:30:31'),(90,55,3,'40 années-lumière... si proche et si loin à la fois.','2026-05-04 17:30:31'),(91,55,25,'Imagine la vie qu\'il pourrait y avoir... 🌌','2026-05-04 17:30:31'),(92,58,6,'Merci pour le résumé ! Tu devrais en faire une newsletter.','2026-05-04 17:30:31'),(93,58,23,'L\'IA domine toutes les news en ce moment.','2026-05-04 17:30:31'),(94,59,16,'J\'ai supprimé Instagram pendant 3 mois. Meilleure décision.','2026-05-04 17:30:31'),(95,59,18,'Le doom scrolling est un vrai problème. Merci d\'en parler.','2026-05-04 17:30:31'),(96,59,20,'Screen Time sur iPhone m\'a ouvert les yeux sur mon usage.','2026-05-04 17:30:32');
