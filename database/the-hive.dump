INSERT INTO `posts` VALUES (1,1,NULL,'','coucou','2026-05-04 09:08:37','2026-05-04 09:08:37'),(2,3,1,'','Test post in Programmation!','2026-05-04 16:57:02','2026-05-04 16:57:02'),(3,1,1,'Bienvenue sur The Hive ! 🐝','Salut à tous ! Ravi de lancer cette communauté. N\'hésitez pas à vous présenter !','2026-05-04 17:30:25','2026-05-04 17:30:25'),(4,3,1,'Comment vous organisez votre journée ?','Perso j\'utilise un bullet journal + Notion. Curieux de savoir comment les autres gèrent leur productivité !','2026-05-04 17:30:25','2026-05-04 17:30:25'),(5,7,1,'Café ou thé ? Le grand débat ☕🍵','Team café ici, mais je comprends les amateurs de thé. Et vous ?','2026-05-04 17:30:25','2026-05-04 17:30:25'),(6,15,1,'Vos podcasts préférés ?','Je cherche de nouveaux podcasts à écouter pendant mes trajets. Des recommandations ?','2026-05-04 17:30:25','2026-05-04 17:30:25'),(7,20,1,'Livres qui ont changé votre vie','Pour moi c\'est Sapiens de Yuval Noah Harari. Et vous, quel livre vous a marqué ?','2026-05-04 17:30:25','2026-05-04 17:30:25'),(8,11,1,'Astuces productivité que personne ne connaît','Ma meilleure astuce : la règle des 2 minutes. Si ça prend moins de 2 min, faites-le tout de suite.','2026-05-04 17:30:25','2026-05-04 17:30:25'),(9,1,2,'Mon setup dev 2026','VSCode + Go + MySQL + un bon terminal. Minimaliste mais efficace. Quel est votre setup ?','2026-05-04 17:30:25','2026-05-04 17:30:25'),(10,6,2,'Docker vs Podman en 2026','Je migre vers Podman pour mes projets perso. Des retours d\'expérience ?','2026-05-04 17:30:25','2026-05-04 17:30:25'),(11,3,2,'Apprendre Go en 2026, bonne idée ?','Go est-il toujours un bon choix pour un débutant en backend ? Des ressources à conseiller ?','2026-05-04 17:30:25','2026-05-04 17:30:25'),(12,6,2,'Linux Mint vs Ubuntu en 2026','Pour un dev qui veut quitter Windows, vous conseillez quoi ?','2026-05-04 17:30:25','2026-05-04 17:30:25'),(13,17,2,'Introduction à la cybersécurité','Par où commencer quand on veut se lancer dans la cybersécurité ? Certifications, labs, livres ?','2026-05-04 17:30:25','2026-05-04 17:30:25'),(14,23,2,'Architecture microservices : overkill ?','Pour un projet perso, est-ce que les microservices valent le coup ou c\'est du over-engineering ?','2026-05-04 17:30:25','2026-05-04 17:30:25'),(15,22,2,'Flutter vs React Native en 2026','Je dois choisir un framework mobile cross-platform. Lequel recommandez-vous et pourquoi ?','2026-05-04 17:30:25','2026-05-04 17:30:25'),(16,13,2,'Les meilleurs outils pour le remote','Notion, Slack, Linear, Figma... Quels sont vos outils indispensables pour le télétravail ?','2026-05-04 17:30:25','2026-05-04 17:30:25'),(17,1,2,'WebAssembly : l\'avenir du web ?','WASM progresse énormément. Pensez-vous que ça va remplacer JavaScript un jour ?','2026-05-04 17:30:25','2026-05-04 17:30:25'),(18,2,3,'Quel est votre jeu du moment ?','Je suis à fond sur Elden Ring. Et vous, qu\'est-ce que vous jouez ?','2026-05-04 17:30:26','2026-05-04 17:30:26'),(19,2,3,'Les meilleurs jeux indés de 2026','Hollow Knight Silksong est une tuerie ! Quels autres indés vous avez aimé ?','2026-05-04 17:30:26','2026-05-04 17:30:26'),(20,5,3,'Animal Crossing, toujours d\'actualité ?','Je viens de reprendre ma sauvegarde après 2 ans. Mon île est en ruine 😂','2026-05-04 17:30:26','2026-05-04 17:30:26'),(21,24,3,'Devenir game designer indé : par où commencer ?','Je veux créer mon propre jeu. Unity ou Godot ? Des conseils pour débuter ?','2026-05-04 17:30:26','2026-05-04 17:30:26'),(22,2,3,'Le meilleur RPG de tous les temps ?','Pour moi c\'est Chrono Trigger. Changez-moi d\'avis.','2026-05-04 17:30:26','2026-05-04 17:30:26'),(23,24,3,'Les jeux qui vous ont fait pleurer','The Last of Us, RDR2, To the Moon... Quels jeux vous ont touché émotionnellement ?','2026-05-04 17:30:26','2026-05-04 17:30:26'),(24,14,3,'Setup gaming : votre config ?','RTX 4070, Ryzen 7, 32Go RAM. Et vous, c\'est quoi votre build ?','2026-05-04 17:30:26','2026-05-04 17:30:26'),(31,9,5,'Débuter la course à pied','Je veux me mettre au running. Des conseils pour un programme débutant ?','2026-05-04 17:30:26','2026-05-04 17:30:26'),(32,9,5,'Match de ce soir : pronostics ?','PSG vs Marseille ce soir ! Qui va gagner selon vous ? ⚽','2026-05-04 17:30:26','2026-05-04 17:30:26'),(33,21,5,'Programme musculation pour débutants','Je partage mon programme de 3 jours/semaine pour ceux qui débutent. Demandez en commentaire !','2026-05-04 17:30:26','2026-05-04 17:30:26'),(34,16,5,'Yoga le matin : mes 30 jours de challenge','J\'ai fait du yoga chaque matin pendant un mois. Voici ce que j\'ai appris.','2026-05-04 17:30:26','2026-05-04 17:30:26'),(35,9,5,'Les JO 2028 : vos attentes ?','Los Angeles 2028 approche ! Quels sports vous avez hâte de suivre ?','2026-05-04 17:30:26','2026-05-04 17:30:26'),(36,8,6,'Top 5 des séries à voir absolument','1. Breaking Bad\n2. The Last of Us\n3. Severance\n4. Dark\n5. Arcane','2026-05-04 17:30:26','2026-05-04 17:30:26'),(37,4,6,'Critique : Dune Part Three','Je sors de la salle et WOW. Villeneuve a encore frappé. Vos avis ?','2026-05-04 17:30:26','2026-05-04 17:30:26'),(38,8,6,'Anime printemps 2026 : vos choix','La saison est incroyable. Je suis à fond sur Jujutsu Kaisen.','2026-05-04 17:30:26','2026-05-04 17:30:26'),(39,14,6,'Studio Ghibli : votre film préféré ?','Pour moi c\'est Le Voyage de Chihiro. Un chef-d\'œuvre indémodable.','2026-05-04 17:30:26','2026-05-04 17:30:26'),(40,8,6,'Les films qui vous ont traumatisé','Requiem for a Dream m\'a hanté pendant des semaines. Et vous ?','2026-05-04 17:30:26','2026-05-04 17:30:26'),(41,20,6,'Faut-il lire le livre avant de voir le film ?','Je suis team \'livre d\'abord\'. Mais parfois le film est meilleur. Vos exemples ?','2026-05-04 17:30:26','2026-05-04 17:30:26'),(42,7,7,'Conseils pour un stage en data science','Je cherche un stage pour cet été. Des conseils sur les entreprises qui recrutent ?','2026-05-04 17:30:27','2026-05-04 17:30:27'),(43,1,7,'Alternance vs Stage : votre avis ?','Je dois choisir entre une alternance et un stage de fin d\'études.','2026-05-04 17:30:27','2026-05-04 17:30:27'),(44,3,7,'Comment réussir ses entretiens tech ?','Partagez vos tips pour les entretiens techniques. LeetCode, projets perso, soft skills ?','2026-05-04 17:30:27','2026-05-04 17:30:27'),(45,18,7,'Études de médecine : la vérité','Je suis en 4ème année et voici ce que j\'aurais aimé savoir avant de commencer.','2026-05-04 17:30:27','2026-05-04 17:30:27'),(46,13,7,'Devenir freelance : retour d\'expérience','Après 2 ans en freelance, voici mon bilan : revenus, liberté, et galères.','2026-05-04 17:30:27','2026-05-04 17:30:27'),(47,4,8,'Tendances UI/UX 2026','Glassmorphism, neumorphism, bento grids... Quelles tendances dominent cette année ?','2026-05-04 17:30:27','2026-05-04 17:30:27'),(48,14,8,'Mes illustrations du mois','Je partage mes dernières créations. N\'hésitez pas à donner votre avis !','2026-05-04 17:30:27','2026-05-04 17:30:27'),(49,19,8,'Débuter en photo de rue','La street photography me fascine. Des conseils pour un débutant avec un smartphone ?','2026-05-04 17:30:27','2026-05-04 17:30:27'),(50,4,8,'Figma vs Sketch vs Adobe XD','Quel outil de design utilisez-vous et pourquoi ? Pour moi c\'est Figma, sans hésiter.','2026-05-04 17:30:27','2026-05-04 17:30:27'),(51,11,9,'Ma recette de ramen maison 🍜','Après 10 essais, j\'ai enfin trouvé la recette parfaite. Je vous partage tout !','2026-05-04 17:30:27','2026-05-04 17:30:27'),(52,11,9,'Meal prep du dimanche','Je prépare tous mes repas le dimanche. Gain de temps et d\'argent énorme !','2026-05-04 17:30:27','2026-05-04 17:30:27'),(53,16,9,'Smoothies protéinés : mes 5 recettes','Parfaits pour après le sport ou le petit-déj. Simples et délicieux.','2026-05-04 17:30:27','2026-05-04 17:30:27'),(54,25,9,'Cuisine du monde : vos plats préférés ?','Pad thaï, tacos, couscous... Quel est votre plat international favori ?','2026-05-04 17:30:27','2026-05-04 17:30:27'),(55,13,10,'Travailler depuis Bali : mon expérience','3 mois en tant que digital nomad à Bali. Budget, coworking, vie quotidienne.','2026-05-04 17:30:27','2026-05-04 17:30:27'),(56,11,10,'Road trip en Écosse 🏴','2 semaines à travers les Highlands. Paysages à couper le souffle !','2026-05-04 17:30:27','2026-05-04 17:30:27'),(57,25,10,'Plongée en Thaïlande','Les fonds marins de Koh Tao sont incroyables. Mon récit et mes conseils.','2026-05-04 17:30:27','2026-05-04 17:30:27'),(58,19,10,'Voyager seul : libérateur ou flippant ?','J\'ai fait mon premier voyage solo et c\'était transformateur. Vos expériences ?','2026-05-04 17:30:27','2026-05-04 17:30:27'),(59,12,11,'Actualités astronomie : nouvelle exoplanète !','Une exoplanète potentiellement habitable découverte à 40 années-lumière. Fascinant !','2026-05-04 17:30:27','2026-05-04 17:30:27'),(60,25,11,'La vie dans les abysses','Les créatures des fonds marins sont plus aliens que les aliens. Thread de photos.','2026-05-04 17:30:27','2026-05-04 17:30:27'),(61,18,11,'L\'IA en médecine : révolution ou danger ?','L\'IA aide déjà au diagnostic. Jusqu\'où ça peut aller ?','2026-05-04 17:30:27','2026-05-04 17:30:27'),(62,15,12,'L\'actu tech de la semaine','Résumé des news les plus importantes de la semaine dans le monde de la tech.','2026-05-04 17:30:27','2026-05-04 17:30:27'),(63,15,12,'Réseaux sociaux et santé mentale','De plus en plus d\'études montrent l\'impact négatif. Comment vous gérez votre usage ?','2026-05-04 17:30:27','2026-05-04 17:30:27'),(64,12,12,'La conquête spatiale en 2026','SpaceX, Blue Origin, Ariane... Où en est-on dans la course à l\'espace ?','2026-05-04 17:30:28','2026-05-04 17:30:28');
