INSERT INTO `direct_messages` VALUES (1,2,1,'comment va *',0,'2026-05-04 16:36:25'),(5,3,3,'Self-message test!',0,'2026-05-04 16:58:08'),(6,2,1,'oiksdàokz',0,'2026-05-04 17:02:09'),(7,2,1,'allo',0,'2026-05-04 17:08:14'),(8,2,1,'allo',0,'2026-05-04 17:08:15'),(9,2,1,'bahahahahahahahahahahahahaha',0,'2026-05-04 17:08:21'),(10,2,1,'tu fais quoi',0,'2026-05-04 17:08:24'),(11,2,1,'claude is my friend and gemini toio',0,'2026-05-04 17:08:31'),(12,2,1,'copilot pue du cuk',0,'2026-05-04 17:08:38'),(13,1,2,'Salut Bob ! Bienvenue sur The Hive 🐝',0,'2026-05-04 17:30:38'),(14,2,1,'Merci Alice ! L\'interface est super clean.',0,'2026-05-04 17:30:38'),(15,1,2,'Merci ! N\'hésite pas si tu as des suggestions.',0,'2026-05-04 17:30:38'),(16,3,1,'Hey Alice, ton post sur le setup dev m\'a donné des idées !',0,'2026-05-04 17:30:38'),(17,1,3,'Cool ! Dis-moi si tu veux qu\'on compare nos configs.',0,'2026-05-04 17:30:38'),(18,4,5,'Emma, tu vas au festival cet été ?',0,'2026-05-04 17:30:38'),(19,5,4,'Oui ! On pourrait y aller ensemble 🎵',0,'2026-05-04 17:30:38'),(20,6,3,'Charlie, t\'as essayé Podman ? Je peux t\'aider.',0,'2026-05-04 17:30:38'),(21,3,6,'Pas encore mais ça m\'intéresse, on en discute !',0,'2026-05-04 17:30:39'),(22,8,9,'Iris, tu regardes le match ce soir ?',0,'2026-05-04 17:30:39'),(23,9,8,'Évidemment ! Allez l\'OM 💙',0,'2026-05-04 17:30:39'),(24,10,4,'Diana, tes designs sont incroyables. Tu utilises quoi ?',0,'2026-05-04 17:30:39'),(25,4,10,'Merci Julien ! Figma principalement, avec Blender pour la 3D.',0,'2026-05-04 17:30:39'),(26,13,11,'Kevin, ta recette de ramen a l\'air dingue !',0,'2026-05-04 17:30:39'),(27,11,13,'Merci Max ! Je t\'envoie la recette complète.',0,'2026-05-04 17:30:39'),(28,22,24,'Yuki, ton jeu avance bien ?',0,'2026-05-04 17:30:39'),(29,24,22,'Oui ! Le prototype est jouable, je t\'envoie un lien.',0,'2026-05-04 17:30:39'),(30,17,6,'Frank, t\'as des ressources sur les CTF ?',0,'2026-05-04 17:30:39'),(31,6,17,'PicoCTF et OverTheWire pour commencer. Fonce !',0,'2026-05-04 17:30:39'),(32,14,4,'Diana, on fait un collab artistique ?',0,'2026-05-04 17:30:39'),(33,4,14,'Trop bien ! Je t\'envoie mes derniers croquis.',0,'2026-05-04 17:30:39'),(34,12,25,'Zoe, tu plonges où cet été ?',0,'2026-05-04 17:30:39'),(35,25,12,'Direction les Maldives ! Tu veux venir ?',0,'2026-05-04 17:30:39'),(36,15,20,'Tina, tu as lu quoi de bien récemment ?',0,'2026-05-04 17:30:39'),(37,20,15,'Project Hail Mary de Andy Weir. Un must-read !',0,'2026-05-04 17:30:39'),(38,2,1,'ll\'ia qui pete les plombs',0,'2026-05-04 17:32:46');
